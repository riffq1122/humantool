[gd_resource type="Resource" script_class="RecipeData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/systems/recipe_data.gd" id="1_recipe"]

[resource]
script = ExtResource("1_recipe")
recipe_id = &"lipstik"
recipe_name = "Buat Lipstik"
required_cards = Array[StringName]([&"cetakan_lipstik", &"pewarna", &"lilin"])
allow_extra_cards = false
consume_process = false
consume_tools = Array[StringName]([])
outputs = Array[StringName]([&"lipstik"])
stem_explanation = "Lilin dan Pewarna dicampur lalu dibentuk di dalam Cetakan hingga memadat menjadi Lipstik siap pakai."
