[ext_resource type="Script" uid="uid://baa3n183fuwdl" path="res://scripts/systems/recipe_data.gd" id="1_recipe_data"]
[ext_resource type="Script" uid="uid://dt0opwg4npnbj" path="res://scripts/systems/failure_outcome_data.gd" id="2_failure_data"]

[sub_resource type="Resource" id="Resource_failure_hammer_ore"]
script = ExtResource("2_failure_data")
failure_id = &"hammer_raw_iron_ore"
trigger_cards = Array[StringName]([&"iron_ore", &"hammer", &"hammering"])
output_card_id = &"crushed_iron_ore"
cause_and_effect_reason = "Menempa Iron Ore mentah dengan Hammer hanya memecah batu menjadi Crushed Iron Ore karena pengotor belum dipisahkan oleh panas. Lebur terlebih dahulu dengan Coal, Furnace, dan Smelting."

[resource]
script = ExtResource("1_recipe_data")
recipe_id = &"iron_ingot"
recipe_name = "Smelt Iron Ingot"
required_cards = Array[StringName]([&"iron_ore", &"coal", &"furnace", &"smelting"])
outputs = Array[StringName]([&"iron_ingot"])
failure_outcomes = Array[ExtResource("2_failure_data")]([SubResource("Resource_failure_hammer_ore")])
stem_explanation = "Pembakaran Coal di dalam Furnace menghasilkan panas tinggi untuk Smelting, sehingga Iron Ore meleleh dan terpisah dari pengotornya menjadi Iron Ingot."
