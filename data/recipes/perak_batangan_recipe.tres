[gd_resource type="Resource" script_class="RecipeData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/systems/recipe_data.gd" id="1_recipe"]

[resource]
script = ExtResource("1_recipe")
recipe_id = &"perak_batangan"
recipe_name = "Buat Perak Batangan"
required_cards = Array[StringName]([&"biji_perak", &"peleburan", &"tungku"])
allow_extra_cards = false
consume_process = false
consume_tools = Array[StringName]([])
outputs = Array[StringName]([&"perak_batangan"])
stem_explanation = "Melalui peleburan di dalam Tungku bersuhu tinggi, Biji Perak mencair dan dimurnikan menjadi Perak Batangan."
