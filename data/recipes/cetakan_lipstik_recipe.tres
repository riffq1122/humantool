[gd_resource type="Resource" script_class="RecipeData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/systems/recipe_data.gd" id="1_recipe"]

[resource]
script = ExtResource("1_recipe")
recipe_id = &"cetakan_lipstik"
recipe_name = "Buat Cetakan"
required_cards = Array[StringName]([&"besi_batangan", &"peleburan", &"tungku"])
allow_extra_cards = false
consume_process = false
consume_tools = Array[StringName]([])
outputs = Array[StringName]([&"cetakan_lipstik"])
stem_explanation = "Besi Batangan dilebur di dalam Tungku hingga dapat dibentuk menjadi Cetakan lipstik yang tahan panas."
